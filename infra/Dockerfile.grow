# The campaign landing page: nginx and eight static files.
#
# Built from the repository root like `Dockerfile.web`, so Coolify points at
# the same repo with this file as its Dockerfile and no base directory.
#
# Deliberately not a Node image and deliberately not part of the pnpm
# workspace: `apps/grow` has no `package.json`, there is nothing to install and
# nothing to build. The approved page is served exactly as it was approved.
FROM nginx:1.27-alpine

# `envsubst`. The base image already carries it via gettext on most tags, but
# pinning the package means the entrypoint cannot fail on a future rebuild.
RUN apk add --no-cache gettext

COPY apps/grow/nginx.conf /etc/nginx/conf.d/default.conf
COPY apps/grow/public/ /usr/share/nginx/html/
COPY apps/grow/tracking.js.template /etc/launchflow/tracking.js.template
COPY apps/grow/docker-entrypoint.sh /docker-entrypoint-launchflow.sh
# The `\r` strip is not superstition. `.gitattributes` pins `*.sh` to LF, but a
# build context is whatever is on disk, and a Windows checkout that predates
# that file — or a `git stash pop` — hands over CRLF. The kernel then looks for
# an interpreter called `/bin/sh\r` and the container exits with
# `no such file or directory`, naming the script rather than the real problem.
RUN sed -i 's/\r$//' /docker-entrypoint-launchflow.sh && chmod +x /docker-entrypoint-launchflow.sh

EXPOSE 80
ENTRYPOINT ["/docker-entrypoint-launchflow.sh"]
CMD ["nginx", "-g", "daemon off;"]

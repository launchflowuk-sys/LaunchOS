FROM node:24-alpine AS base
RUN corepack enable && corepack prepare pnpm@11.12.0 --activate
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY apps/web/package.json apps/web/
COPY packages ./packages
RUN pnpm install --frozen-lockfile --filter @launchos/web...
COPY apps/web ./apps/web
RUN pnpm --filter @launchos/web build
# Set after the build: `next build` needs devDependencies, and `next start` sets
# NODE_ENV=production for its own process anyway. Setting it on the image makes
# the whole runtime — the migrate step in CMD included — production, so the
# adapter guard in `apps/web/src/instrumentation.ts` is armed even if the
# Coolify resource is missing the variable.
ENV NODE_ENV=production
EXPOSE 3000
# Serving only. Migrations are a one-shot step run *before* this container
# starts — Coolify's pre-deployment command, the `migrate` service in
# `docker-compose.coolify.yml`, or `docker exec … pnpm --filter @launchos/db
# migrate` by hand (docs/DEPLOYMENT.md, "Migrations").
#
# They used to be part of this CMD (`migrate && start`). Three things that got
# wrong: a failing migration became a crash-loop outage of both portals rather
# than a deferred schema change, because `&&` short-circuits and Coolify
# restarts; a second web replica would have run `drizzle-kit migrate`
# concurrently against one database with no advisory lock; and no migration
# could be applied without restarting the app. The image still carries the
# migrations and drizzle-kit, so the one-shot step runs from this same image.
CMD ["pnpm", "--filter", "@launchos/web", "start"]

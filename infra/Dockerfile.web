FROM node:24-alpine AS base
RUN corepack enable && corepack prepare pnpm@11.12.0 --activate
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY apps/web/package.json apps/web/
COPY packages ./packages
RUN pnpm install --frozen-lockfile --filter @launchos/web...
COPY apps/web ./apps/web
RUN pnpm --filter @launchos/web build
# Set after the build: `next build` needs devDependencies, and `next start` sets
# NODE_ENV=production for its own process anyway. Setting it on the image makes
# the whole runtime — the migrate step in CMD included — production, so the
# adapter guard in `apps/web/src/instrumentation.ts` is armed even if the
# Coolify resource is missing the variable.
ENV NODE_ENV=production
EXPOSE 3000
CMD ["sh", "-c", "pnpm --filter @launchos/db migrate && pnpm --filter @launchos/web start"]

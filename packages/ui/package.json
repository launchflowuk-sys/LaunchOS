{
  "name": "@launchflow/ui",
  "version": "0.1.0",
  "description": "The LaunchFlow design system — tokens, primitives and components for admin portals and client-facing apps.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src",
    "DESIGN.md",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles": "./src/styles/globals.css",
    "./ui/*": "./src/components/ui/*.tsx",
    "./components/*": "./src/components/*.tsx",
    "./components/portal/*": "./src/components/portal/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./package.json": "./package.json",
    "./styles/marketing": "./src/styles/marketing.css",
    "./styles/motion": "./src/styles/motion.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.550.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.4.1"
  },
  "devDependencies": {
    "typescript": "^5",
    "@launchos/config": "workspace:*",
    "@types/react": "^19",
    "react": "19.2.8",
    "vitest": "^3"
  },
  "keywords": [
    "design-system",
    "tailwind",
    "shadcn",
    "admin",
    "launchflow"
  ],
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "next": ">=15"
  }
}

{
  "name": "@launchos/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./passwords": "./src/passwords.ts",
    "./test": "./src/test/db.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "studio": "drizzle-kit studio",
    "seed": "tsx src/seed.ts",
    "bootstrap": "tsx src/bootstrap.ts",
    "reconcile-support-emails": "tsx src/scripts/reconcile-support-emails.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@launchos/config": "workspace:*",
    "@launchos/core": "workspace:*",
    "@launchos/integrations": "workspace:*",
    "@types/node": "^24",
    "better-auth": "^1.7.2",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3"
  }
}

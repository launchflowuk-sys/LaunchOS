# ---- Database (self-hosted Postgres, Coolify in prod, docker compose locally) ----
DATABASE_URL=postgres://launchos:launchos@localhost:5432/launchos

# ---- App ----
NODE_ENV=development
APP_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# ---- Client support addresses ----
# Every client gets <slug>@SUPPORT_EMAIL_DOMAIN. Plan 4 routes real mail to it.
SUPPORT_EMAIL_DOMAIN=support.launchflow.co.uk
# In-app notifications always reach the owner; set this to also email them (Plan 4).
OWNER_NOTIFY_EMAIL=

# ---- Dev / bootstrap seed only (pnpm db:seed) ----
# Never leave these set on a running production resource.
# SEED_OWNER_PASSWORD is the first owner's login: set it for the one bootstrap
# run, sign in, then remove it and redeploy. The seed refuses to run with
# NODE_ENV=production unless it is set, so the development default below can
# never ship. SEED_OWNER_EMAIL records which address that owner is created
# under; the seed currently hardcodes this value, so change it there too if you
# bootstrap under a different address.
SEED_OWNER_EMAIL=shujaat@nexusedu.co.uk
SEED_OWNER_PASSWORD=change-me-now

# ---- AI (Claude API) ----
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5

# ---- Email channel (SMTP adapter; Resend/Postmark adapters can be added later) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="LaunchFlow Support <support@launchflow.example>"
# Inbound email webhook shared secret (set the same value in the provider)
INBOUND_EMAIL_SECRET=change-me

# ---- Integrations (all optional; mock adapters are used when unset) ----
COOLIFY_API_URL=
COOLIFY_API_TOKEN=
CLOUDFLARE_API_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
META_ADS_ACCESS_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ---- Uptime probe: mock | http (mock is used in tests and local dev) ----
UPTIME_PROBE=mock
MOCK_DOWN_URLS=
# ---- LLM client: anthropic | fake ----
LLM=anthropic

# ---- Agent policy ----
# safe | approval_all  (default "safe": internal/mock actions run, outward-facing actions queue for approval)
AGENT_POLICY=safe

# ---- Database (self-hosted Postgres, Coolify in prod, docker compose locally) ----
# The one connection string. The web app, the worker, pg-boss, the migrations
# and both seeding scripts all read it, and its host is half of what decides
# whether a database counts as a production target.
DATABASE_URL=postgres://launchos:launchos@localhost:5432/launchos

# ---- App ----
# development | production. Read by the worker's env validation and by the seed;
# `production` makes the seed treat the target as live, which is what requires
# SEED_OWNER_EMAIL below to be set rather than defaulted. `pnpm db:bootstrap`
# does not read it at all — its guards are unconditional.
NODE_ENV=development
# Where this install is served from. Used for the portal links agents put in
# client emails, so a wrong value sends clients somewhere that does not exist.
# Both env schemas refuse this value under NODE_ENV=production — a client
# emailed a portal link would be sent to their own machine — so a deployed
# resource must carry its real address, e.g. https://os.launchflow.co.uk.
APP_URL=http://localhost:3000
# Signing key for Better Auth sessions. There is deliberately no value here:
# anything printed in this repository is not a secret, and `cp .env.example .env`
# is exactly how one used to reach a live deployment and sign every session
# cookie — the owner's included — with a value anyone can read.
#
#   openssl rand -base64 48
#
# `apps/web/src/lib/env.ts` refuses to start on a blank value, on one shorter
# than 32 characters, and on any placeholder published here (`change-me`,
# `change-me-now`, …), in every environment. Generate one before `pnpm dev`.
BETTER_AUTH_SECRET=
# Better Auth's own base URL; falls back to APP_URL when unset.
BETTER_AUTH_URL=http://localhost:3000

# ---- Support intake (Plan 4) ----
# Domain the per-client support addresses live on, e.g.
# grays-cabline@support.launchflow.co.uk. Unlocks inbound routing: the webhook
# matches a recipient against email_identities.address to find the client.
SUPPORT_EMAIL_DOMAIN=support.launchflow.co.uk
# The address in the footer of every branded email: where a client writes when
# they have not been given a case-specific one. Defaults to
# hello@$SUPPORT_EMAIL_DOMAIN, so it only needs setting to point somewhere else.
SUPPORT_CONTACT_EMAIL=
# Which inbound webhook payload shape to expect: generic | postmark | cloudflare.
# The ?provider= query parameter on the webhook URL overrides this per request.
INBOUND_EMAIL_PROVIDER=generic
# Outbound mail: mock (records the send only, the default) | smtp (needs SMTP_* below).
# The mock SUCCEEDS: it returns a message id, so the reply is marked `sent` with
# a `delivered_at` and never leaves. That is why a production process refuses to
# start on it — see "Adapters in production" below.
EMAIL_ADAPTER=mock
# Owner in-app notifications are also emailed here when set. Leave unset to
# keep the notifications bell as the only channel.
OWNER_NOTIFY_EMAIL=
# Where inbound attachments are written. Mount a persistent volume here in
# production or attachments vanish on redeploy.
STORAGE_DIR=./storage

# ---- Bootstrap (pnpm db:bootstrap) and dev seed (pnpm db:seed) ----
# Never leave these set on a running production resource.
# `pnpm db:bootstrap` is the production entry point: it creates the
# organisation and the owner account and nothing else, from the variables
# below. `pnpm db:seed` is the development fixture — demo clients, invoices,
# ad data and a portal login — and refuses to run at all unless SEED_DEMO=1,
# which this file ships set and a production resource must never carry. Both
# read SEED_ORG_NAME / SEED_ORG_SLUG for the
# organisation and SEED_OWNER_EMAIL for the owner's address, so seeding a
# bootstrapped database fills the organisation already there rather than
# creating a second one beside it.
# `pnpm db:bootstrap` is the production tool, so ITS guards are unconditional:
# in every environment and against every host it refuses a SEED_OWNER_PASSWORD
# that is still one of the defaults below, requires SEED_OWNER_EMAIL to be set,
# and requires BOOTSTRAP_CONFIRM. No host check can stand in for that — an SSH
# tunnel presents a live database as localhost, a Hetzner private network as
# 10.x, and this repo's own production compose file names its database host
# `postgres`. To bootstrap LOCALLY, pass an address, a real password and the
# confirmation for the one run:
#   SEED_OWNER_EMAIL=you@example.com SEED_OWNER_PASSWORD='a-real-long-password' BOOTSTRAP_CONFIRM=launchflow pnpm db:bootstrap
# `pnpm db:seed` has one gate of its own and it is the same shape: SEED_DEMO=1,
# in every environment and against every host (see that key below). The
# "production target" inference — NODE_ENV=production OR a DATABASE_URL whose
# host is not local (localhost, 127.x, IPv6 loopback, the compose names
# postgres/db, or a private 10./172.16-31./192.168./fc00:: address; a missing,
# unparseable, socket-only or multi-host URL counts as production) — no longer
# guards anything that writes. It decides two things only: the (local) /
# (production target) note on the seed's printed database line, and whether
# SEED_OWNER_EMAIL must be set rather than defaulted. Being wrong there costs
# one variable, which is the only direction a hostname guess is worth making.
# SEED_OWNER_PASSWORD is the first owner's login: set it for the one bootstrap
# run, sign in, then remove it and redeploy. In EVERY environment both scripts
# also refuse a password shorter than 12 characters — the same floor the app
# enforces on staff and clients, and the only place it can be applied to a
# credential written directly into the database. Every refusal names the guard
# that tripped and exits non-zero.
SEED_ORG_NAME=LaunchFlow
# Leave unset for "launchflow". Set but empty is a refusal, not a default: it
# must be 2-63 characters of lowercase letters, digits and hyphens. Values are
# trimmed, so a stray space cannot make a second organisation.
SEED_ORG_SLUG=launchflow
# The owner's address: the account you will sign in as, and the only account
# that can. `pnpm db:bootstrap` has NO default for it and refuses to run until
# it is set, in every environment — a forgotten variable would otherwise create
# the one privileged account of a live tenant under an address committed to
# this repository, and report it as success. The dev seed keeps a built-in
# default so `pnpm db:seed` still runs with this key left blank, but requires
# the variable when its target is production. A value that is not an address is
# refused either way.
SEED_OWNER_EMAIL=
# The name on the owner's user row, used only when the bootstrap creates
# that row; an existing user keeps the name it has. Defaults to "Owner".
SEED_OWNER_NAME=
SEED_OWNER_PASSWORD=change-me-now
# `pnpm db:bootstrap` only, and in EVERY environment: it must equal
# SEED_ORG_SLUG (trimmed, and never empty) or the run is refused. The bootstrap
# creates an organisation whenever it finds no row with that slug, so a mistyped
# slug would otherwise silently create a second, empty one and leave you signed
# in to it. Left empty here because `pnpm db:seed`, the local path, does not read
# it; set it on the command line for the one bootstrap run.
BOOTSTRAP_CONFIRM=
# Demo data — never set this in production. `pnpm db:seed` runs only when it is
# exactly 1, in EVERY environment and against every host: the fixtures include
# invoices numbered from a live sequence, which are not cleanly reversible, and
# an owner account that may still carry the published default password below.
# It is a flag rather than a host check because no hostname can tell a local
# database from a live one behind an SSH tunnel (`ssh -L 5433:…` presents
# production as localhost), on a private network, or under the compose name
# `postgres`. It ships set here so local development is `cp .env.example .env`
# and nothing more; on a production resource leave it out entirely and use
# `pnpm db:bootstrap`, which writes only the organisation and the owner account.
SEED_DEMO=1
# The portal login the seed creates for Grays CabLine, so the client portal can
# be signed into after a fresh seed. This is a CLIENT credential and must never
# be the owner's: the owner's password opens the whole admin shell — every
# client, invoice and approval — while this one opens one client's portal. It
# therefore has its own default and is never derived from SEED_OWNER_PASSWORD.
# SEED_DEMO=1 is what lets these defaults reach a database at all, and it is the
# only guard that holds against a host no string can judge — a tunnel, a private
# network, the compose name `postgres`. Beside it the seed still refuses a
# password published in this repository, and a client password equal to the
# owner's, whenever NODE_ENV=production or the database is not demonstrably
# local: belt and braces, not a substitute for the flag. On a live install do not
# run the seed at all — bootstrap the owner, then create portal users from the
# admin Portal Users screen, which issues a one-time password. The default
# address is `.example` so a seed can never create a login on a real,
# deliverable client domain.
SEED_CLIENT_EMAIL=portal@grayscabline.example
SEED_CLIENT_PASSWORD=change-me-client

# ---- AI (Claude API) ----
# Required whenever LLM=anthropic — the only value production should ever carry,
# though this file ships LLM=fake below so a fresh clone's worker starts. The
# Anthropic SDK does not complain about a missing key until the first request,
# so the worker refuses LLM=anthropic without one rather than failing every
# agent run one at a time. Set this, then set LLM=anthropic.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5

# ---- Email channel (SMTP adapter; Resend/Postmark adapters can be added later) ----
# Required when EMAIL_ADAPTER=smtp: this is what actually delivers a staff or
# approved-agent reply. With EMAIL_ADAPTER=mock the send is recorded, not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The verified sender every outbound reply goes out as; use the same domain the
# SPF and DKIM records were published on.
MAIL_FROM="LaunchFlow Support <support@launchflow.example>"
# Inbound email webhook shared secret. The provider must send it as the
# x-launchos-inbound-secret header or POST /api/webhooks/email/inbound is a 401,
# so no mail reaches the inbox until this matches on both sides. Blank here for
# the same reason as BETTER_AUTH_SECRET: it is the only credential on that
# route, and a value published in this repository lets anyone raise tickets and
# manufacture conversations against any client.
#
#   openssl rand -base64 48
#
# `apps/web/src/lib/env.ts` refuses to start on a blank value, on one shorter
# than 24 characters, and on any placeholder published here. The e2e suite reads
# it from this file with no fallback of its own.
INBOUND_EMAIL_SECRET=

# ---- Payments (Stripe) ----
# mock | stripe. The Stripe adapter is only selected when PAYMENTS_ADAPTER=stripe
# AND both secrets below are set; anything else falls back to the mock adapter.
# The Stripe webhook route (POST /api/webhooks/stripe) refuses with 503 unless
# the real adapter is configured — it will never accept mock-signed events.
PAYMENTS_ADAPTER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Read by Settings → Billing only, which renders it as "Set" / "Not set" and
# never displays the value. No adapter uses it yet; it is listed so the screen
# names a variable this file actually documents.
STRIPE_PUBLISHABLE_KEY=
# Invoice payment terms in days, and VAT as a whole-number percentage.
PAYMENT_TERMS_DAYS=14
VAT_RATE=20

# ---- Ads ----
# mock | google | meta (mock is used in tests and local dev). Only the mock is
# wired: google and meta are interface-only and still build the mock, so asking
# for either in production is a refusal rather than a silent downgrade.
ADS_ADAPTER=mock
# Local/test only: an ISO date (YYYY-MM-DD) from which the mock ads adapter
# reports a collapse in performance, so the Ad Performance Sentinel has
# something to flag. Unset means steady metrics all the way back.
MOCK_ADS_DROP_FROM=

# ---- Adapters in production ----
# Under NODE_ENV=production both the web app and the worker refuse to start when
# an adapter resolves to a mock. The reasoning is ALLOW_FAKE_LLM's, one step
# worse: a mock adapter does not fail, it succeeds. A worker deployed without
# EMAIL_ADAPTER=smtp marks every client reply, ad report and invoice email
# `sent` and delivers none of them, and nothing anywhere says otherwise.
#
# Refused in production: EMAIL_ADAPTER=mock, PAYMENTS_ADAPTER=mock,
# UPTIME_PROBE=mock, and any value that cannot be honoured and quietly falls
# back to the mock (PAYMENTS_ADAPTER=stripe with either STRIPE_* secret missing,
# ADS_ADAPTER=google|meta). The adapters with no real implementation at all —
# ads, hosting, DNS, CMS — are not refused; they are printed at startup instead.
#
# Set this to exactly 1 to say the mocks were meant: a staging resource, or a
# production deploy before the SPF and DKIM records verify. Any other value is
# still a refusal. Both processes log the resolved adapter names (names only) in
# their first line, so what is actually wired is visible without reading env.
ALLOW_MOCK_ADAPTERS=

# ---- Integrations (placeholders — nothing reads these yet) ----
# Every variable in this block is a NAME RESERVED FOR A CLIENT THAT IS NOT
# WRITTEN. Do not go and acquire the credentials on their account: setting one
# changes nothing anywhere, and the mock provider is what answers either way.
# Only the four in Settings → Billing are read at all, and only to render
# "Set" / "Not set"; the value is never displayed and never sent anywhere.
#
# Coolify, behind the Hosting Guard-Dog's hosting_get_resources tool.
# `MockHostingProvider` takes its answers from a constructor overrides map and
# reads no environment at all, so these two are inert.
COOLIFY_API_URL=
COOLIFY_API_TOKEN=
# Cloudflare DNS, behind the approval-gated dns_update_record tool. Same again:
# `MockCloudflareDns` records the change and reports success; no zone is touched
# until the real client lands.
CLOUDFLARE_API_TOKEN=
# Google Ads and Meta Ads. `createAdsAdapter` always builds the mock, so no
# adapter reads these. Settings → Billing renders each as "Set" / "Not set" so a
# live install can see which credentials it is still missing.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
META_ADS_ACCESS_TOKEN=
META_ADS_AD_ACCOUNT_ID=
# Twilio, for the WhatsApp channel `packages/channels` does not have yet.
# Nothing reads these; they are listed so this file and docs/DEPLOYMENT.md agree.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ---- Uptime probe: mock | http (mock is used in tests and local dev) ----
# The mock reports every site up, so production refuses it (see "Adapters in
# production" above).
UPTIME_PROBE=mock
# Local/test only: a comma-separated list of site URLs the mock probe reports as
# down, so an incident and a Hosting Guard-Dog run can be provoked on demand.
MOCK_DOWN_URLS=

# ---- LLM client: anthropic | fake ----
# fake LLM for local runs; production sets LLM=anthropic and ANTHROPIC_API_KEY;
# the worker refuses LLM=fake in production unless ALLOW_FAKE_LLM=1 (ALLOW_MOCK_ADAPTERS=1
# is the same opt-out, one step over, for the adapters).
#
# "fake" is shipped here so `pnpm dev:worker` comes up on a fresh clone: the
# schema's first rule refuses LLM=anthropic with no ANTHROPIC_API_KEY in every
# environment, and this file ships that key blank, so the alternative was a
# quick start whose last line does not run. It is a scripted stub
# (apps/worker/src/llm/fake.ts) — the same client the e2e suite uses, for the
# same reason: deterministic runs, no key, no cost. Set ANTHROPIC_API_KEY above
# and LLM=anthropic for real agent runs.
#
# Production must carry LLM=anthropic. The worker refuses "fake" under
# NODE_ENV=production unless ALLOW_FAKE_LLM=1 says it was meant, because a
# production worker running it would raise approvals from canned text. The
# startup line names the client and model in use, so a mis-set LLM is visible in
# the first line of the log rather than in the agents' behaviour a day later.
LLM=fake
ALLOW_FAKE_LLM=

# ---- Agent policy ----
# safe | approval_all  (default "safe": internal/mock actions run, outward-facing actions queue for approval)
AGENT_POLICY=safe

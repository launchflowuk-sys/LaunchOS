{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$(git rev-parse --show-toplevel 2>/dev/null)/scripts/claude-checkpoint.sh\" save 2>/dev/null || true",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$(git rev-parse --show-toplevel 2>/dev/null)/scripts/claude-checkpoint.sh\" save 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$(git rev-parse --show-toplevel 2>/dev/null)/scripts/claude-checkpoint.sh\" save 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$(git rev-parse --show-toplevel 2>/dev/null)/scripts/claude-checkpoint.sh\" context 2>/dev/null",
            "timeout": 20
          }
        ]
      }
    ]
  }
}

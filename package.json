{
  "name": "launchos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "pnpm --filter @launchos/web dev",
    "dev:worker": "pnpm --filter @launchos/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @launchos/db generate",
    "db:migrate": "pnpm --filter @launchos/db migrate",
    "db:seed": "pnpm --filter @launchos/db seed",
    "db:studio": "pnpm --filter @launchos/db studio",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "eslint": "^9",
    "typescript-eslint": "^8"
  }
}
